<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.chenxinjie</groupId>
        <artifactId>upload-file</artifactId>
        <version>1.0.0</version>
        <relativePath>../..</relativePath>
    </parent>

    <artifactId>upload-file-boot4-demo</artifactId>
    <name>upload-file-boot4-demo</name>
    <description>Demo application: Spring Boot 4 (jakarta) large-file chunked upload / resumable download demo using upload-file-spring-boot-starter-jakarta</description>

    <properties>
        <!-- The demo application is not published to the Central Repository -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- Import the Spring Boot 4 BOM module-locally (jakarta); overrides the parent Boot 2.7 BOM.
             Version property inherited from the parent pom (spring.boot4.version). -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot4.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Pin h2/jedis to the project-managed versions (inherited from the parent POM): the
                 store modules were built against them, and the Boot 4 BOM would otherwise supply
                 its own (possibly incompatible) versions for these artifacts. -->
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
            <dependency>
                <groupId>redis.clients</groupId>
                <artifactId>jedis</artifactId>
                <version>${jedis.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>cn.chenxinjie</groupId>
            <artifactId>upload-file-spring-boot-starter-jakarta</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Optional metadata-store plugins, exercised by the jdbc / redis profiles (application-jdbc.yml,
             application-redis.yml). -->
        <dependency>
            <groupId>cn.chenxinjie</groupId>
            <artifactId>upload-file-store-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.chenxinjie</groupId>
            <artifactId>upload-file-store-redis</artifactId>
        </dependency>
        <!-- JDBC profile: spring-boot-starter-jdbc provides the DataSource auto-configuration
             (Hikari + spring-jdbc) and h2 the embedded database, so the jdbc profile runs with no
             external service. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Redis profile: Jedis client for upload-file-store-redis (no server-side dependency). -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Demo-level smoke tests (@SpringBootTest), part of the normal mvn test build. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot4.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
